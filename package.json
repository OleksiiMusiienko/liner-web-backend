{
  "name": "liner-web-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Web backend for Liner",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },

  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "axios": "^1.21.0",
    "fastify": "^5.12.8"
  }
}
