{
  "name": "liner-web-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Web backend for Liner",
  "type": "module",
  "scripts": {  
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
},

